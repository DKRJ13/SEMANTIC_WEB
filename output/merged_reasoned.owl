<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://hospital-b.org/clinical"
         xmlns="http://hospital-b.org/clinical#"
         xmlns:ehr="http://hospital-a.org/ehr#"
         xmlns:med="http://hospital-c.org/med#"
         xmlns:id="http://snomed.info/id/">

<owl:Ontology rdf:about="http://hospital-b.org/clinical">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hospital B - Clinical &amp; Trial Data Ontology</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A semantically rich clinical ontology with domain/range constraints and disjoint classes.</rdfs:comment>
</owl:Ontology>

<owl:Ontology rdf:about="http://hospital-a.org/ehr">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hospital A - Electronic Health Record (EHR) Ontology</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A semantically rich local ontology structurally enforcing EHR documentation standards.</rdfs:comment>
</owl:Ontology>

<owl:Ontology rdf:about="http://snomed.info/id/core">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SNOMED CT Subset</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A lightweight simulation of SNOMED CT using real SCTIDs for integration.</rdfs:comment>
</owl:Ontology>

<owl:Ontology rdf:about="http://hospital-c.org/med"/>

<owl:Ontology rdf:about="http://medonto.org/snomed-mapping-A"/>

<owl:Ontology rdf:about="http://medonto.org/snomed-rules"/>

<owl:Ontology rdf:about="http://medonto.org/snomed-mapping-B"/>

<owl:Ontology rdf:about="http://medonto.org/snomed-mapping-C"/>

<owl:ObjectProperty rdf:about="#consultsWith">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="#ClinicalStaff"/>
  <rdfs:range rdf:resource="#ClinicalStaff"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">consults with peer safely (symmetric)</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://hospital-a.org/ehr#hasCondition">
  <rdfs:domain rdf:resource="http://hospital-a.org/ehr#EHR_Record"/>
  <rdfs:range rdf:resource="http://hospital-a.org/ehr#Condition"/>
  <owl:equivalentProperty rdf:resource="http://snomed.info/id/associatedWith"/>
  <owl:equivalentProperty rdf:resource="#hasDiagnosis"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has condition</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://snomed.info/id/associatedWith">
  <owl:equivalentProperty rdf:resource="http://hospital-a.org/ehr#hasCondition"/>
  <owl:equivalentProperty rdf:resource="#hasDiagnosis"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has clinical finding</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://hospital-a.org/ehr#hasParent">
  <rdfs:subPropertyOf rdf:resource="http://hospital-a.org/ehr#hasAncestor"/>
  <owl:equivalentProperty rdf:resource="http://snomed.info/id/hasBiologicalParent"/>
  <owl:equivalentProperty rdf:resource="#hasBiologicalParent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has biological parent</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://hospital-a.org/ehr#hasPrescription">
  <rdfs:domain rdf:resource="http://hospital-a.org/ehr#EHR_Record"/>
  <rdfs:range rdf:resource="http://hospital-a.org/ehr#Prescription"/>
  <owl:equivalentProperty rdf:resource="http://snomed.info/id/prescribedTo"/>
  <owl:equivalentProperty rdf:resource="#onMedication"/>
  <owl:equivalentProperty rdf:resource="http://hospital-c.org/med#administeredDrug"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has prescription</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://hospital-a.org/ehr#seenBy">
  <rdfs:domain rdf:resource="http://hospital-a.org/ehr#EHR_Record"/>
  <rdfs:range rdf:resource="http://hospital-a.org/ehr#AttendingPhysician"/>
  <owl:inverseOf rdf:resource="http://hospital-a.org/ehr#treatsPatient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is seen by</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDiagnosis">
  <rdfs:domain rdf:resource="#ClinicalSubject"/>
  <rdfs:range rdf:resource="#Diagnosis"/>
  <owl:equivalentProperty rdf:resource="http://snomed.info/id/associatedWith"/>
  <owl:equivalentProperty rdf:resource="http://hospital-a.org/ehr#hasCondition"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has confirmed diagnosis</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasNutritionEntry">
  <rdfs:domain rdf:resource="#ClinicalSubject"/>
  <rdfs:range rdf:resource="#NutritionEntry"/>
  <owl:equivalentProperty rdf:resource="http://snomed.info/id/consumes"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">consumed nutritional item</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#underCareOf">
  <rdfs:domain rdf:resource="#ClinicalSubject"/>
  <rdfs:range rdf:resource="#ClinicalStaff"/>
  <owl:inverseOf rdf:resource="#caresFor"/>
  <owl:equivalentProperty rdf:resource="http://hospital-a.org/ehr#seenBy"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is under the primary care of</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#knowsPatient">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="#ClinicalSubject"/>
  <rdfs:range rdf:resource="#ClinicalSubject"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is friends with another patient</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#caresFor">
  <rdfs:domain rdf:resource="#ClinicalStaff"/>
  <rdfs:range rdf:resource="#ClinicalSubject"/>
  <owl:inverseOf rdf:resource="#underCareOf"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">provides care for</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#onMedication">
  <rdfs:domain rdf:resource="#ClinicalSubject"/>
  <rdfs:range rdf:resource="#Medication"/>
  <owl:equivalentProperty rdf:resource="http://snomed.info/id/prescribedTo"/>
  <owl:equivalentProperty rdf:resource="http://hospital-a.org/ehr#hasPrescription"/>
  <owl:equivalentProperty rdf:resource="http://hospital-c.org/med#administeredDrug"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is currently taking medication</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://snomed.info/id/hasRisk">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has interaction risk</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://snomed.info/id/prescribedTo">
  <owl:equivalentProperty rdf:resource="http://hospital-a.org/ehr#hasPrescription"/>
  <owl:equivalentProperty rdf:resource="#onMedication"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is prescribed product</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#eligibleForPeerSecondOpinionFrom">
  <rdfs:domain rdf:resource="#ClinicalSubject"/>
  <rdfs:range rdf:resource="#ClinicalStaff"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#knowsPatient"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#underCareOf"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eligible for peer network second opinion</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://hospital-a.org/ehr#hasAncestor">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="http://hospital-a.org/ehr#EHR_Record"/>
  <rdfs:range rdf:resource="http://hospital-a.org/ehr#EHR_Record"/>
  <owl:equivalentProperty rdf:resource="http://snomed.info/id/hasBiologicalAncestor"/>
  <owl:equivalentProperty rdf:resource="#hasBiologicalAncestor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has biological ancestor</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://snomed.info/id/hasBiologicalAncestor">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <owl:equivalentProperty rdf:resource="http://hospital-a.org/ehr#hasAncestor"/>
  <owl:equivalentProperty rdf:resource="#hasBiologicalAncestor"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://snomed.info/id/hasRiskOfGeneticDisease">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://snomed.info/id/hasBiologicalAncestor"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://snomed.info/id/hasGeneticDisease"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://hospital-a.org/ehr#reliesOnColleague">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="http://hospital-a.org/ehr#MedicalPersonnel"/>
  <rdfs:range rdf:resource="http://hospital-a.org/ehr#MedicalPersonnel"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relies on specialist colleague</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasBiologicalParent">
  <rdfs:subPropertyOf rdf:resource="#hasBiologicalAncestor"/>
  <owl:equivalentProperty rdf:resource="http://snomed.info/id/hasBiologicalParent"/>
  <owl:equivalentProperty rdf:resource="http://hospital-a.org/ehr#hasParent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biological parent</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://hospital-a.org/ehr#treatsPatient">
  <rdfs:domain rdf:resource="http://hospital-a.org/ehr#AttendingPhysician"/>
  <rdfs:range rdf:resource="http://hospital-a.org/ehr#EHR_Record"/>
  <owl:inverseOf rdf:resource="http://hospital-a.org/ehr#seenBy"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">treats patient</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://hospital-c.org/med#administeredDrug">
  <rdfs:domain rdf:resource="http://hospital-c.org/med#MedicalRecord"/>
  <rdfs:range rdf:resource="http://hospital-c.org/med#Drug"/>
  <owl:equivalentProperty rdf:resource="http://snomed.info/id/prescribedTo"/>
  <owl:equivalentProperty rdf:resource="http://hospital-a.org/ehr#hasPrescription"/>
  <owl:equivalentProperty rdf:resource="#onMedication"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasBiologicalAncestor">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#ClinicalSubject"/>
  <rdfs:range rdf:resource="#ClinicalSubject"/>
  <owl:equivalentProperty rdf:resource="http://snomed.info/id/hasBiologicalAncestor"/>
  <owl:equivalentProperty rdf:resource="http://hospital-a.org/ehr#hasAncestor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biological ancestor</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://snomed.info/id/hasBiologicalParent">
  <rdfs:subPropertyOf rdf:resource="http://hospital-a.org/ehr#hasAncestor"/>
  <owl:equivalentProperty rdf:resource="http://hospital-a.org/ehr#hasParent"/>
  <owl:equivalentProperty rdf:resource="#hasBiologicalParent"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://snomed.info/id/consumes">
  <owl:equivalentProperty rdf:resource="#hasNutritionEntry"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">consumes substance</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://hospital-a.org/ehr#hasGeneticCondition">
  <rdfs:subPropertyOf rdf:resource="http://hospital-a.org/ehr#hasCondition"/>
  <owl:equivalentProperty rdf:resource="http://snomed.info/id/hasGeneticDisease"/>
  <owl:equivalentProperty rdf:resource="#hasGeneticDiagnosis"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has confirmed genetic disease</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://snomed.info/id/hasGeneticDisease">
  <rdfs:subPropertyOf rdf:resource="http://hospital-a.org/ehr#hasCondition"/>
  <owl:equivalentProperty rdf:resource="http://hospital-a.org/ehr#hasGeneticCondition"/>
  <owl:equivalentProperty rdf:resource="#hasGeneticDiagnosis"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasGeneticDiagnosis">
  <rdfs:subPropertyOf rdf:resource="#hasDiagnosis"/>
  <owl:equivalentProperty rdf:resource="http://snomed.info/id/hasGeneticDisease"/>
  <owl:equivalentProperty rdf:resource="http://hospital-a.org/ehr#hasGeneticCondition"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">confirmed genetic diagnosis</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#eligibleForSecondOpinionFrom">
  <rdfs:domain rdf:resource="#ClinicalSubject"/>
  <rdfs:range rdf:resource="#ClinicalStaff"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#underCareOf"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#consultsWith"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eligible for second opinion from</rdfs:label>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="http://hospital-c.org/med#Name">
  <rdfs:domain rdf:resource="http://hospital-c.org/med#MedicalRecord"/>
  <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://hospital-a.org/ehr#FullName">
  <rdfs:domain rdf:resource="http://hospital-a.org/ehr#Person"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://hospital-a.org/ehr#Gender">
  <rdfs:domain rdf:resource="http://hospital-a.org/ehr#Person"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasSpecialty">
  <rdfs:domain rdf:resource="#ClinicalOfficer"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#Patient_Name">
  <rdfs:domain rdf:resource="#Human"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://hospital-a.org/ehr#hasSpecialty">
  <rdfs:domain rdf:resource="http://hospital-a.org/ehr#MedicalPersonnel"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#Subject_Ref">
  <rdfs:domain rdf:resource="#ClinicalSubject"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://hospital-a.org/ehr#PatientID">
  <rdfs:domain rdf:resource="http://hospital-a.org/ehr#EHR_Record"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://hospital-a.org/ehr#BloodType">
  <rdfs:domain rdf:resource="http://hospital-a.org/ehr#EHR_Record"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://hospital-a.org/ehr#DateOfBirth">
  <rdfs:domain rdf:resource="http://hospital-a.org/ehr#Person"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#BMI">
  <rdfs:domain rdf:resource="#ClinicalSubject"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#Sex">
  <rdfs:domain rdf:resource="#Human"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#DOB">
  <rdfs:domain rdf:resource="#ClinicalSubject"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#ClinicalOfficer">
  <rdfs:subClassOf rdf:resource="#ClinicalStaff"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clinical Officer / NP</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Specialist">
  <rdfs:subClassOf rdf:resource="#ClinicalStaff"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Medical Specialist</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ClinicalStaff">
  <rdfs:subClassOf rdf:resource="#Human"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clinical Staff Member</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Diagnosis">
  <rdfs:subClassOf rdf:resource="#Observation"/>
  <owl:equivalentClass rdf:resource="http://snomed.info/id/404684003"/>
  <rdfs:subClassOf rdf:resource="http://hospital-a.org/ehr#ClinicalConcept"/>
  <owl:equivalentClass rdf:resource="http://hospital-a.org/ehr#Condition"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Confirmed Diagnosis</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Observation">
  <rdfs:subClassOf rdf:resource="#ClinicalEntity"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clinical Observation</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://snomed.info/id/404684003">
  <owl:equivalentClass rdf:resource="http://hospital-a.org/ehr#Condition"/>
  <owl:equivalentClass rdf:resource="#Diagnosis"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clinical finding (Disease)</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://hospital-a.org/ehr#EHR_Record">
  <rdfs:subClassOf rdf:resource="http://hospital-a.org/ehr#Person"/>
  <owl:disjointWith rdf:resource="http://hospital-a.org/ehr#MedicalPersonnel"/>
  <owl:equivalentClass rdf:resource="http://snomed.info/id/125676002"/>
  <owl:equivalentClass rdf:resource="#ClinicalSubject"/>
  <owl:equivalentClass rdf:resource="http://hospital-c.org/med#MedicalRecord"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electronic Health Record (Patient Profile)</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://hospital-a.org/ehr#Condition">
  <rdfs:subClassOf rdf:resource="http://hospital-a.org/ehr#ClinicalConcept"/>
  <owl:equivalentClass rdf:resource="http://snomed.info/id/404684003"/>
  <owl:equivalentClass rdf:resource="#Diagnosis"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Medical Condition or Disease</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ClinicalSubject">
  <rdfs:subClassOf rdf:resource="#Human"/>
  <owl:disjointWith rdf:resource="#ClinicalStaff"/>
  <owl:equivalentClass rdf:resource="http://snomed.info/id/125676002"/>
  <rdfs:subClassOf rdf:resource="http://hospital-a.org/ehr#Person"/>
  <owl:equivalentClass rdf:resource="http://hospital-a.org/ehr#EHR_Record"/>
  <owl:equivalentClass rdf:resource="http://hospital-c.org/med#MedicalRecord"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clinical Trial Subject / Patient</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Medication">
  <rdfs:subClassOf rdf:resource="#Regimen"/>
  <owl:equivalentClass rdf:resource="http://snomed.info/id/373873005"/>
  <owl:equivalentClass rdf:resource="http://hospital-a.org/ehr#Prescription"/>
  <owl:equivalentClass rdf:resource="http://hospital-c.org/med#Drug"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Active Medication</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://snomed.info/id/373873005">
  <rdfs:subClassOf rdf:resource="http://hospital-a.org/ehr#Intervention"/>
  <rdfs:subClassOf rdf:resource="#Regimen"/>
  <owl:equivalentClass rdf:resource="http://hospital-a.org/ehr#Prescription"/>
  <owl:equivalentClass rdf:resource="#Medication"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pharmaceutical / biologic product</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://hospital-c.org/med#MedicalRecord">
  <owl:equivalentClass rdf:resource="http://snomed.info/id/125676002"/>
  <owl:equivalentClass rdf:resource="http://hospital-a.org/ehr#EHR_Record"/>
  <owl:equivalentClass rdf:resource="#ClinicalSubject"/>
</owl:Class>

<owl:Class rdf:about="http://snomed.info/id/709044004">
  <rdfs:subClassOf rdf:resource="http://snomed.info/id/404684003"/>
  <rdfs:subClassOf rdf:resource="http://hospital-a.org/ehr#Condition"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chronic kidney disease</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://hospital-a.org/ehr#MedicalPersonnel">
  <rdfs:subClassOf rdf:resource="http://hospital-a.org/ehr#Person"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Medical Personnel</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://hospital-c.org/med#Drug">
  <owl:equivalentClass rdf:resource="http://snomed.info/id/373873005"/>
  <owl:equivalentClass rdf:resource="http://hospital-a.org/ehr#Prescription"/>
  <owl:equivalentClass rdf:resource="#Medication"/>
</owl:Class>

<owl:Class rdf:about="#NutritionEntry">
  <rdfs:subClassOf rdf:resource="#Regimen"/>
